# Copy this file to .env and fill in your credentials.
# NEVER commit your actual .env file.

EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_API_SECRET=your_api_secret_here
# Optional passphrase (required by some exchanges, e.g. Kucoin)
EXCHANGE_PASSPHRASE=

# Telegram bot credentials (required for --find-positions mode)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL_ID=your_telegram_channel_id_here

# Primary timeframe used by all strategies and find_positions scanner.
# Overrides the timeframes.primary value in config.yaml.
# Valid ccxt strings: 1m, 5m, 15m, 30m, 1h, 4h, 1d  (default: 1h)
PRIMARY_TIMEFRAME=1h
